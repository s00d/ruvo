# Cabinet demo env (optional overrides)
# Cascade: .env.dev|.env.prod|.env.test → .env.{mode} → .env.local → .env
# (later wins; real process env always wins). Copy to `.env` and/or `.env.dev`.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
TASKS_BEARER=cabinet-dev-secret

# Overrides [db] url in ruvo.toml when set:
# DATABASE_URL=postgres://postgres@localhost/ruvo

# Mail — without URL, try_from_env / from_env uses fake; invalid URL errors (no silent fake)
# RUVO_MAIL=fake
# RUVO_MAIL=smtp
# RUVO_MAIL_URL=smtp://user:pass@smtp.example.com:587
# RUVO_MAIL_FROM=Cabinet <noreply@ruvo.local>
# SMTP_URL=...   # alias for RUVO_MAIL_URL
# RUVO_MAIL=file
# RUVO_MAIL_PATH=./mail

# Object storage — cabinet uses Storage::local(public/uploads) by default.
# For S3/MinIO/R2 wiring see examples/misc/storage and:
# RUVO_STORAGE=s3
# RUVO_STORAGE_BUCKET=ruvo
# RUVO_STORAGE_ENDPOINT=http://127.0.0.1:9000
# RUVO_STORAGE_REGION=auto
# RUVO_STORAGE_FORCE_PATH_STYLE=1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# # AWS_SESSION_TOKEN=
# # RUVO_STORAGE_ROOT=uploads
# # RUVO_STORAGE_PUBLIC_URL=http://127.0.0.1:9000/ruvo
