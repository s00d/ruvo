# Cabinet demo env (optional overrides)
# Cascade: .env.dev|.env.prod|.env.test → .env.{mode} → .env.local → .env
# (later wins; real process env always wins). Copy to `.env` and/or `.env.dev`.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
TASKS_BEARER=cabinet-dev-secret

# Overrides [db] url in sova.toml when set:
# DATABASE_URL=postgres://postgres@localhost/sova
# (default in sova.toml is sqlite:cabinet.db)

# Mail — without URL, try_from_env / from_env uses fake; invalid URL errors (no silent fake)
# SOVA_MAIL=fake
# SOVA_MAIL=smtp
# SOVA_MAIL_URL=smtp://user:pass@smtp.example.com:587
# SOVA_MAIL_FROM=Cabinet <noreply@sova.local>
# SMTP_URL=...   # alias for SOVA_MAIL_URL
# SOVA_MAIL=file
# SOVA_MAIL_PATH=./mail

# Object storage — cabinet uses Storage::local(public/uploads) by default.
# For S3/MinIO/R2 wiring see examples/misc/storage and:
# SOVA_STORAGE=s3
# SOVA_STORAGE_BUCKET=sova
# SOVA_STORAGE_ENDPOINT=http://127.0.0.1:9000
# SOVA_STORAGE_REGION=auto
# SOVA_STORAGE_FORCE_PATH_STYLE=1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# # AWS_SESSION_TOKEN=
# # SOVA_STORAGE_ROOT=uploads
# # SOVA_STORAGE_PUBLIC_URL=http://127.0.0.1:9000/sova
